# Server Configuration
PORT=5000
NODE_ENV=development

# Database & Redis Infrastructure
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/reachinbox?schema=public
REDIS_URL=redis://localhost:6379

# SMTP Configuration (Ethereal Email for Dev/Testing)
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_SENDER_1=
ETHEREAL_SENDER_2=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack Integration Configuration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200

# Rate Limiting & Queue Concurrency Settings
MAX_EMAILS_PER_HOUR_PER_SENDER=50
MIN_DELAY_MS=2000
WORKER_CONCURRENCY=5
